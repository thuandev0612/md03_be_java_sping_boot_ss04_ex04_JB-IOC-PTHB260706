{
  "info": {
    "_postman_id": "21bf7217-6054-4a7d-8f5e-ffbb3c9d6034",
    "name": "Session04 - Bai4 - Course enrollment",
    "description": "Run the folders in order. The first request clears IDs from the previous run; POST tests capture new IDs from Location as strings. All API bodies use ApiResponse with data: null. Each complete run creates one instructor, course, student and enrollment in the configured database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Happy flow (run in order)",
      "description": "Create an instructor, create a course, activate the course, create a student and enroll the student.",
      "item": [
        {
          "name": "01 - Create instructor",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "[\"instructorId\", \"courseId\", \"studentId\", \"enrollmentId\"].forEach(function (name) {",
                  "    pm.collectionVariables.unset(name);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"success is true\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"success\", true);",
                  "});",
                  "pm.test(\"message is a non-empty string\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"message\");",
                  "    pm.expect(body.message).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"data is exactly null\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"data\", null);",
                  "});",
                  "pm.test(\"Location contains the generated instructorId\", function () {",
                  "    const location = pm.response.headers.get(\"Location\");",
                  "    pm.expect(location).to.be.a(\"string\");",
                  "    const match = location.match(/\\/instructors\\/([0-9]+)\\/?$/);",
                  "    pm.expect(match, \"Location must end in /instructors/{id}\").not.to.equal(null);",
                  "    pm.collectionVariables.set(\"instructorId\", match[1]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Session04 Instructor\",\n  \"email\": \"instructor.session04@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/instructors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instructors"
              ]
            }
          },
          "response": []
        },
